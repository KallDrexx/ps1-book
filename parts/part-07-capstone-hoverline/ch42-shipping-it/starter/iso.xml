<?xml version="1.0" encoding="utf-8"?>
<!-- Processed by CMake (configure_file) and then by mkpsxiso. Paths are relative to the build directory;
     a file from the source tree needs ${PROJECT_SOURCE_DIR} in front. -->
<iso_project>
	<track type="data">
		<identifiers
			system        ="PLAYSTATION"
			application   ="PLAYSTATION"
			volume        ="HOVERLINE"
			volume_set    ="HOVERLINE"
			publisher     ="PS1BOOK"
			data_preparer ="MKPSXISO"
			copyright     ="README.TXT;1"
		/>
		<directory_tree>
			<file name="SYSTEM.CNF" type="data" source="${PROJECT_SOURCE_DIR}/system.cnf" />
			<file name="HOVER.EXE"  type="data" source="game.exe" />
			<dir name="DATA">
				<file name="LOGO.TIM"   type="data" source="assets/LOGO.TIM" />
				<file name="PROPS.TPK"  type="data" source="assets/PROPS.TPK" />
				<file name="PYLON.SHP"  type="data" source="assets/PYLON.SHP" />
				<file name="ARCH.SHP"   type="data" source="assets/ARCH.SHP" />
				<file name="TOWER.SHP"  type="data" source="assets/TOWER.SHP" />
				<file name="SCENE.BIN"  type="data" source="assets/SCENE.BIN" />
				<file name="TRACK.TRK"  type="data" source="assets/TRACK.TRK" />
				<file name="TRACK2.TRK" type="data" source="assets/TRACK2.TRK" />
				<file name="TRACK.TPK"  type="data" source="assets/TRACK.TPK" />
				<file name="SHIP.SHP"   type="data" source="assets/SHIP.SHP" />
				<file name="SHIP.TPK"   type="data" source="assets/SHIP.TPK" />
				<file name="ENGINE.VAG" type="data" source="assets/ENGINE.VAG" />
				<file name="BOOST.VAG"  type="data" source="assets/BOOST.VAG" />
				<file name="THUD.VAG"   type="data" source="assets/THUD.VAG" />
				<file name="BEEP.VAG"   type="data" source="assets/BEEP.VAG" />
				<file name="GO.VAG"     type="data" source="assets/GO.VAG" />
			</dir>
			<dummy sectors="1024"/>
		</directory_tree>
	</track>
	<!-- Chapter 39: the music, as a CD-DA track (track 2). The WAV must be 44.1 kHz, 16-bit, stereo. -->
	<track type="audio" source="assets/MUSIC.WAV" />
</iso_project>
